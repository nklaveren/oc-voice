# Auto-enter the dev shell on cd, so `just` and `cargo` just work.
# Requires direnv + nix-direnv; without them this file is inert and you
# enter the shell manually with `nix develop`.
#
# First time in this directory, direnv will ask you to allow it:
#   direnv allow
#
# Machine-local overrides go in .envrc.local (gitignored).
use flake

[ -f .envrc.local ] && source_env .envrc.local
